{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devanimecx.github.io/free-ai-agent-stack/schemas/free-tier.schema.json",
  "title": "Free tier infrastructure entry",
  "description": "One entry in data/free-tiers.yaml (hosting, database, auth, observability, etc).",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "category",
      "description",
      "free_limit",
      "requires_card",
      "url",
      "verified",
      "verified_by",
      "status"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "minLength": 3,
        "maxLength": 60
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      },
      "category": {
        "enum": [
          "hosting",
          "compute",
          "database",
          "vector-db",
          "auth",
          "storage",
          "queue",
          "observability",
          "analytics",
          "email",
          "search"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 20,
        "maxLength": 280
      },
      "free_limit": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      },
      "requires_card": {
        "type": "boolean"
      },
      "cold_start_risk": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "description": "How likely is this to sleep, spin down or queue under free-tier limits?"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "docs_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "maxItems": 12,
        "uniqueItems": true
      },
      "verified": {
        "type": "string",
        "format": "date"
      },
      "verified_by": {
        "type": "string",
        "pattern": "^@[A-Za-z0-9-]+$"
      },
      "status": {
        "enum": [
          "active",
          "degraded",
          "broken",
          "deprecated"
        ]
      },
      "notes": {
        "description": "Caveats worth reading. A string or a list of strings.",
        "anyOf": [
          {
            "type": "string",
            "maxLength": 400
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          }
        ]
      }
    }
  }
}
