{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeaiagentstack.dev/schemas/llm-api.schema.json",
  "title": "Free LLM API entry",
  "description": "One entry in data/llm-apis.yaml. Validated in CI by scripts/validate.py.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "provider",
      "free_limit",
      "requires_card",
      "url",
      "verified",
      "verified_by",
      "status"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "minLength": 3,
        "maxLength": 60,
        "description": "Immutable kebab-case identifier. Once merged it never changes."
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      },
      "provider": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      },
      "description": {
        "type": "string",
        "minLength": 20,
        "maxLength": 280
      },
      "free_limit": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      },
      "free_limit_tokens_per_day": {
        "type": "integer",
        "minimum": 0
      },
      "requires_card": {
        "type": "boolean",
        "description": "Must be explicit. Set true when unknown \u2014 never mislead a developer."
      },
      "requires_phone": {
        "type": "boolean"
      },
      "rate_limit": {
        "type": "string",
        "maxLength": 120
      },
      "models": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 30
      },
      "modalities": {
        "type": "array",
        "items": {
          "enum": [
            "text",
            "vision",
            "audio",
            "video",
            "image-gen",
            "embeddings",
            "rerank",
            "speech-to-text",
            "text-to-speech",
            "translation",
            "ocr"
          ]
        },
        "uniqueItems": true
      },
      "context_window": {
        "type": "integer",
        "minimum": 0
      },
      "commercial_use": {
        "type": "boolean"
      },
      "data_used_for_training": {
        "type": [
          "boolean",
          "null"
        ],
        "description": "Trust signal: does the free tier train on your prompts?"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "docs_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "signup_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "maxItems": 12,
        "uniqueItems": true
      },
      "verified": {
        "type": "string",
        "format": "date",
        "description": "ISO date a human last confirmed URL and free limit."
      },
      "verified_by": {
        "type": "string",
        "pattern": "^@[A-Za-z0-9-]+$"
      },
      "status": {
        "enum": [
          "active",
          "degraded",
          "broken",
          "deprecated"
        ]
      },
      "notes": {
        "description": "Caveats worth reading. A string or a list of strings.",
        "anyOf": [
          {
            "type": "string",
            "maxLength": 400
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          }
        ]
      }
    }
  }
}
